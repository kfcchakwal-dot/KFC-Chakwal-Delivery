rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active != false)
      );
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /collections/{id} { allow read: if true; allow write: if admin(); }
    match /deliveryMethods/{id} { allow read: if true; allow write: if admin(); }
    match /storeSettings/{id} { allow read: if admin(); allow write: if admin(); }
    match /themeSettings/{id} { allow read: if true; allow write: if admin(); }
    match /policies/{id} { allow read: if true; allow write: if admin(); }
    match /discounts/{id} { allow read: if true; allow write: if admin(); }
    match /dailyDeals/{id} { allow read: if true; allow write: if admin(); }

    match /customers/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if admin() || (
        owner(uid) &&
        request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'email', 'defaultAddress', 'savedAddresses',
          'loyaltyPoints', 'totalSpent', 'totalOrdersCount', 'createdAt'
        ]) &&
        request.resource.data.loyaltyPoints == 50 &&
        request.resource.data.totalSpent == 0 &&
        request.resource.data.totalOrdersCount == 0
      );
      allow update: if admin() || (
        owner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'email', 'defaultAddress', 'savedAddresses', 'updatedAt'
        ])
      );
      allow delete: if admin();
    }

    match /orders/{id} {
      allow read: if admin() || (signedIn() && resource.data.customer.uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.customer.uid == request.auth.uid &&
        request.resource.data.status == 'confirmed';
      allow update, delete: if admin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if admin() || (signedIn() && resource.data.customerUid == request.auth.uid);
    }

    match /vipMembers/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    match /marketingCampaigns/{id} { allow read, write: if admin(); }
    match /abandonedCheckouts/{id} { allow read, write: if admin(); }
    match /notifications/{id} { allow read, write: if admin(); }
    match /adminUsers/{uid} { allow read: if admin() || owner(uid); allow write: if admin(); }

    match /test/{id} { allow read: if false; allow write: if false; }
  }
}
