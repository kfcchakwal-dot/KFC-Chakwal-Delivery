rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active != false)
      );
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /collections/{id} { allow read: if true; allow write: if admin(); }
    match /deliveryMethods/{id} { allow read: if true; allow write: if admin(); }
    match /storeSettings/{id} { allow read: if admin(); allow write: if admin(); }
    // Sanitized storefront-only data; secrets stay out of this public document.
    match /storePublic/{id} { allow read: if true; allow write: if admin(); }
    match /themeSettings/{id} { allow read: if true; allow write: if admin(); }
    match /policies/{id} { allow read: if true; allow write: if admin(); }
    match /discounts/{id} { allow read: if true; allow write: if admin(); }
    match /dailyDeals/{id} { allow read: if true; allow write: if admin(); }

    match /customers/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if admin() || (
        owner(uid) &&
        request.resource.data.id == uid &&
        request.resource.data.keys().hasOnly([
          'id', 'fullName', 'phone', 'email', 'address', 'defaultAddress',
          'savedAddresses', 'loyaltyPoints', 'totalSpent', 'totalOrdersCount',
          'ordersCount', 'createdAt', 'updatedAt', 'vipTier', 'vipStatus'
        ]) &&
        request.resource.data.loyaltyPoints == 50 &&
        request.resource.data.totalSpent == 0 &&
        (!('totalOrdersCount' in request.resource.data) || request.resource.data.totalOrdersCount == 0) &&
        (!('ordersCount' in request.resource.data) || request.resource.data.ordersCount == 0)
      );
      allow update: if admin() || (
        owner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'email', 'address', 'defaultAddress', 'savedAddresses', 'updatedAt'
        ])
      );
      allow delete: if admin();
    }

    match /orders/{id} {
      allow read: if admin() || (signedIn() && resource.data.customer.uid == request.auth.uid);
      allow create: if request.resource.data.status == 'confirmed' &&
        (
          (!signedIn() && !('uid' in request.resource.data.customer)) ||
          (signedIn() && request.resource.data.customer.uid == request.auth.uid)
        );
      allow update, delete: if admin();
    }

    match /vipRequests/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if admin() || (
        signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if admin();
    }

    match /reviews/{id} {
      allow read: if true;
      // Reviews are intentionally open without phone OTP or customer sign-in.
      // Keep public writes constrained to the fields and values the storefront uses.
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'productId', 'customerName', 'rating', 'comment', 'date', 'customerUid', 'isVisible'
        ]) &&
        request.resource.data.productId is string &&
        request.resource.data.productId.size() > 0 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 80 &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 &&
        request.resource.data.comment.size() <= 1000 &&
        request.resource.data.date is string &&
        request.resource.data.isVisible == true &&
        (signedIn()
          ? request.resource.data.customerUid == request.auth.uid
          : request.resource.data.customerUid == null);
      allow update, delete: if admin() || (signedIn() && resource.data.customerUid == request.auth.uid);
    }

    match /vipMembers/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    // Admin-owned FCM tokens let the trusted server send new-order push alerts.
    match /adminPushTokens/{tokenId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if admin() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0;
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Order review-request history is private to authorized admins.
    match /reviewRequests/{id} { allow read, write: if admin(); }

    match /marketingCampaigns/{id} { allow read, write: if admin(); }
    match /abandonedCheckouts/{id} { allow read, write: if admin(); }
    match /notifications/{id} { allow read, write: if admin(); }
    match /adminUsers/{uid} { allow read: if admin() || owner(uid); allow write: if admin(); }

    match /test/{id} { allow read: if false; allow write: if false; }
  }
}
